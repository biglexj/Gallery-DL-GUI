{
  "manifest_version": 3,
  "name": "Gallery-DL GUI Connector",
  "version": "1.0.0",
  "description": "Puente inteligente para enviar descargas, interceptar imágenes y sincronizar cookies con Gallery-DL-GUI.",
  "permissions": [
    "cookies",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://*.deviantart.com/*",
    "*://*.pixiv.net/*",
    "*://images-wixmp-*.wixmp.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.deviantart.com/*",
        "*://*.pixiv.net/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
